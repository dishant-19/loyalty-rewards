# MySQL connection values. Configure these as server environment variables.
# For XAMPP defaults, DB_HOST=127.0.0.1, DB_PORT=3306, DB_NAME=boxbonus,
# DB_USER=root and DB_PASS= (empty). config.php reads process environment variables.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=boxbonus
DB_USER=root
DB_PASS=
